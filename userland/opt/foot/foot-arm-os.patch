+void
+cmd_scrollback_to(struct terminal *term, int position, int extent)
+{
+    int scrollback_start;
+    int empty_rows = 0;
+    int populated_rows;
+    int available_rows;
+    int new_view;
+
+    if (term->grid == &term->alt || urls_mode_is_active(term) ||
+        term->mouse_tracking != MOUSE_NONE || extent <= 0)
+        return;
+
+    scrollback_start = term->grid->offset + term->rows;
+    while (empty_rows < term->grid->num_rows &&
+           term->grid->rows[
+               scrollback_start & (term->grid->num_rows - 1)] == NULL) {
+        scrollback_start++;
+        empty_rows++;
+    }
+    populated_rows = term->grid->num_rows - empty_rows;
+    available_rows = populated_rows - term->rows;
+    if (available_rows <= 0)
+        return;
+
+    position = max(0, min(position, extent));
+    new_view = scrollback_start +
+        (int)((int64_t)position * available_rows / extent);
+    new_view &= term->grid->num_rows - 1;
+    if (new_view == term->grid->view)
+        return;
+
+    selection_cancel(term);
+    term->grid->view = new_view;
+    term_damage_view(term);
+    render_refresh_urls(term);
+    render_refresh(term);
+}
