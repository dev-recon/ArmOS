+static void
+render_arm_os_scrollback_bar(struct terminal *term)
+{
+    struct wl_window *win = term->window;
+    int scrollback_start = term->grid->offset + term->rows;
+    int empty_rows = 0;
+
+    while (empty_rows < term->grid->num_rows &&
+           term->grid->rows[
+               scrollback_start & (term->grid->num_rows - 1)] == NULL) {
+        scrollback_start++;
+        empty_rows++;
+    }
+
+    int populated_rows = term->grid->num_rows - empty_rows;
+    if (populated_rows <= term->rows) {
+        if (win->scrollback_indicator.surf != NULL)
+            wayl_win_subsurface_destroy(&win->scrollback_indicator);
+        return;
+    }
+
+    if (win->scrollback_indicator.surf == NULL &&
+        !wayl_win_subsurface_new(win, &win->scrollback_indicator)) {
+        LOG_ERR("failed to create scrollback bar surface");
+        return;
+    }
+
+    int rebased_view =
+        term->grid->view - scrollback_start + term->grid->num_rows;
+    rebased_view &= term->grid->num_rows - 1;
+    int available_rows = populated_rows - term->rows;
+    rebased_view = max(0, min(rebased_view, available_rows));
+    int scale = term->scale;
+    int width = 10 * scale;
+    int height = term->height - term->margins.top - term->margins.bottom;
+
+    height = height / scale * scale;
+    if (height <= 0)
+        return;
+
+    int thumb_height = max(2 * term->cell_height,
+        (int)((int64_t)height * term->rows / populated_rows));
+    thumb_height = min(thumb_height, height);
+    int thumb_y = available_rows > 0
+        ? (int)((int64_t)(height - thumb_height) * rebased_view /
+                available_rows)
+        : 0;
+
+    struct buffer *buf = shm_get_buffer(
+        term->render.chains.scrollback_indicator, width, height);
+    pixman_color_t track = color_hex_to_pixman_with_alpha(
+        0x3b4652u, 0xd000);
+    pixman_color_t thumb = color_hex_to_pixman_with_alpha(
+        0x56bdf0u, 0xffff);
+
+    pixman_image_fill_rectangles(
+        PIXMAN_OP_SRC, buf->pix[0], &track, 1,
+        &(pixman_rectangle16_t){0, 0, width, height});
+    pixman_image_fill_rectangles(
+        PIXMAN_OP_SRC, buf->pix[0], &thumb, 1,
+        &(pixman_rectangle16_t){0, thumb_y, width, thumb_height});
+
+    int x = term->width - term->margins.right - width;
+    int y = term->margins.top;
+    x = max(0, x);
+    wl_subsurface_set_position(
+        win->scrollback_indicator.sub, x / scale, y / scale);
+    quirk_weston_subsurface_desync_on(win->scrollback_indicator.sub);
+    wl_surface_attach(win->scrollback_indicator.surf, buf->wl_buf, 0, 0);
+    wl_surface_damage_buffer(
+        win->scrollback_indicator.surf, 0, 0, width, height);
+    wl_surface_set_buffer_scale(win->scrollback_indicator.surf, scale);
+    wl_surface_set_opaque_region(win->scrollback_indicator.surf, NULL);
+    wl_surface_commit(win->scrollback_indicator.surf);
+    quirk_weston_subsurface_desync_off(win->scrollback_indicator.sub);
+}
